# ============================================================
# SUPABASE CONFIGURATION (LADZDZAH PORTFOLIO)
# ============================================================
# Dapatkan nilai ini dari Project Settings -> API di https://supabase.com
# Salin file ini menjadi .env.local untuk pengujian di komputer lokal,
# atau masukkan ke 'Environment Variables' di Project Settings Vercel.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
